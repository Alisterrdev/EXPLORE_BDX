<section class="hero">
  <!-- Fallback image (invisible tant que la vidéo joue) -->
  <img
    src="<%= image_path('bordeaux.jpeg') %>"
    alt="Bordeaux"
    class="hero__fallback"
    aria-hidden="true"
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none;z-index:0;pointer-events:none;">

  <!-- Vidéo en arrière-plan du HERO -->
  <video
    class="hero__bg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="<%= image_path('bordeaux.jpeg') %>"
    aria-hidden="true"
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;pointer-events:none;">
    <source src="<%= asset_path('bordeaux.mp4') %>" type="video/mp4">
  </video>

  <!-- Voile pour la lisibilité du texte -->
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- CARD superposée -->
  <div class="hero__card">
    <h2 class="hero__title">Explore Bordeaux.<br>
    <strong>Trouver</strong>, choisir, <strong>sortir.</strong></h2>
    <p class="hero__text">
      L’outil qui trouve vos sorties en un clic.
    </p>
    <button class="hero__button">Je me lance</button>

  </div>

  <!-- JS désactivé → force l'image -->
  <noscript>
    <style>
      .hero__bg{display:none!important}
      .hero__fallback{display:block!important}
    </style>
  </noscript>
</section>

<script>
document.querySelector('.hero__button').addEventListener('click', () => {
  document.querySelector('.filters-title-mood').scrollIntoView({ behavior: 'smooth' });
});
</script>

<!-- Bloc process -->
<section class="process">
  <div class="step">
    <div class="step-number">1</div>
    <div class="step-text">
      <h2>Choisis ton mood</h2>
      <p>Festif ou plutôt chill ?</p>
    </div>
  </div>

  <div class="step">
    <div class="step-number">2</div>
    <div class="step-text">
      <h2>Ton budget</h2>
      <p>Il n'est jamais loin.</p>
    </div>
  </div>

  <div class="step">
    <div class="step-number">3</div>
    <div class="step-text">
      <h2>Ta localisation & ta date</h2>
      <p>Ou pas, à toi de voir.</p>
    </div>
  </div>
</section>
<% moods = {
  "Nature"   => "moods/nature.jpg",
  "Creatif"  => "moods/creatif.jpg",
  "Festif"   => "moods/festif.jpg",
  "Foodies"  => "moods/foodies.jpg",
  "Culturel" => "moods/culturel.jpg",
  "Chill"    => "moods/chill.jpg"
} %>

<% budgets = {
  "Gratuit"               => "budget/Gratuit.png",
  "Entre_0_et_40_euros"   => "budget/Entre_0_et_40_euros.png",
  "Plus_de_40_euros"      => "budget/Plus_de_40_euros.png"
} %>

<%= form_with url: events_path, method: :get, class: "filters-form" do %>

  <!-- MOODS -->
    <h2 class="filters-title-mood">Ton mood</h2>
    <p class="filters-subtitle">On adapte nos suggestions en fonction de ton humeur.</p>
<section class="mood-section">
    <div class="mood-grid">
      <% moods.each do |tag, img| %>
        <% id = "tag_#{tag.parameterize}" %>
        <input type="checkbox"
               name="tags"
               value="<%= tag %>"
               id="<%= id %>"
               class="mood-check">

        <label for="<%= id %>" class="mood-card" style="--photo: url('<%= asset_path(img) %>')">
          <span class="mood-card__photo"></span>
          <span class="mood-card__title"><%= tag %></span>
        </label>
      <% end %>
    </div>
  </section>

  <!-- BUDGET -->
    <h2 class="filters-title-budget">Ton budget</h2>
    <p class="filters-subtitle">Ton portefeuille aussi à son mot à dire 😉</p>
  <section class="budget-section">
    <div class="budget-grid">
      <% budgets.each do |label, img| %>
        <% id = "budget_#{label.parameterize}" %>
        <input type="radio"
               name="budget"
               value="<%= label %>"
               id="<%= id %>"
               class="budget-input">

        <label for="<%= id %>" class="budget-card">
          <span class="budget-card__title">
            <%= label.gsub("_", " ").gsub("euros","€").capitalize %>
          </span>
        </label>
      <% end %>
    </div>
  </section>
<h2 class="localisation__title">Ta localisation</h2>
<p class="filters-subtitle">On te propose les spots près de toi.</p>

<section class="localisation">
  <div class="container">
    <div style="text-align: center;">
      <input type="range" name="location" min="10" max="30" step="10" value="20" class="localisation__range">

      <!-- Les labels DOIVENT être DANS ce div -->
      <div class="localisation__labels">
        <span>10 km</span>
        <span>20 km</span>
        <span>30 km</span>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  const range = document.querySelector('.localisation__range');
  if (!range) return;

  const labelsWrap = document.querySelector('.localisation__labels');
  const spans = labelsWrap ? labelsWrap.querySelectorAll('span') : [];
  const ro = new ResizeObserver(() => { layout(); });

  function halfThumbPx(){
    const cs = getComputedStyle(range);
    const s  = parseFloat(cs.getPropertyValue('--thumb-size'))   || 0;
    const b  = parseFloat(cs.getPropertyValue('--thumb-border')) || 0;
    return s/2 + b; // débord visuel réel
  }

  function paint(){
    const min = +range.min || 0, max = +range.max || 100, val = +range.value || min;
    const p = ((val - min) * 100) / (max - min); // 10->0, 20->50, 30->100
    range.style.setProperty('--fill', p + '%');
  }

  function layout(){
    if (!labelsWrap) return;
    // aligne la largeur + position du bloc labels sur l'input
    const rRect  = range.getBoundingClientRect();
    const pRect  = labelsWrap.parentElement.getBoundingClientRect();
    labelsWrap.style.width = Math.round(rRect.width) + 'px';
    labelsWrap.style.marginLeft = Math.round(rRect.left - pRect.left) + 'px';
    labelsWrap.style.marginRight = 'auto';

    // positions x = 0% / 50% / 100% de la piste utile
    const h = halfThumbPx();
    const track = rRect.width - 2*h;
    if (spans[0]) { spans[0].style.left = h + 'px';                spans[0].style.transform = 'translateX(0)'; }
    if (spans[1]) { spans[1].style.left = (h + track/2) + 'px';    spans[1].style.transform = 'translateX(-50%)'; }
    if (spans[2]) { spans[2].style.left = (h + track) + 'px';      spans[2].style.transform = 'translateX(-100%)'; }
  }
  function positionLabels() {
  const labelsWrap = document.querySelector('.localisation__labels');
  if (!labelsWrap) return;
  const spans = labelsWrap.querySelectorAll('span');
  if (spans.length < 3) return;

  // 1) Caler la largeur + position du bloc labels sur l'input
  const rRect  = range.getBoundingClientRect();
  const pRect  = labelsWrap.parentElement.getBoundingClientRect();
  labelsWrap.style.width = Math.round(rRect.width) + 'px';
  labelsWrap.style.marginLeft = Math.round(rRect.left - pRect.left) + 'px';
  labelsWrap.style.marginRight = 'auto';

  // 2) Piste utile = largeur input - 2 * halfThumb
  const cs = getComputedStyle(range);
  const thumbSize   = parseFloat(cs.getPropertyValue('--thumb-size'))   || 0;
  const thumbBorder = parseFloat(cs.getPropertyValue('--thumb-border')) || 0;
  const halfThumb   = thumbSize/2 + thumbBorder;
  const trackWidth  = rRect.width - 2 * halfThumb;

  // 3) Offsets personnalisables depuis le CSS du bloc labels
  const csLabels = getComputedStyle(labelsWrap);
  const startOffset = parseFloat(csLabels.getPropertyValue('--label-start-offset')) || 0;
  const endOffset   = parseFloat(csLabels.getPropertyValue('--label-end-offset'))   || 0;

  // 4) Positions pixel-parfait
  const x0 = halfThumb + startOffset;          // début + offset
  const x1 = halfThumb + trackWidth/2;         // milieu
  const x2 = halfThumb + trackWidth + endOffset; // fin + offset

  spans[0].style.left = x0 + 'px';
  spans[0].style.transform = 'translateX(0)';

  spans[1].style.left = x1 + 'px';
  spans[1].style.transform = 'translateX(-50%)';

  spans[2].style.left = x2 + 'px';
  spans[2].style.transform = 'translateX(-100%)';
}

  function init(){
    paint();
    layout();
    ro.observe(range); // suit les changements de taille (responsive)
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();

  window.addEventListener('resize', layout);
  range.addEventListener('input', paint);
  range.addEventListener('change', paint);
})();
</script>

