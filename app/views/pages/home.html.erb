<section class="hero">
  <!-- Fallback image (invisible tant que la vidéo joue) -->
  <img
    src="<%= image_path('bordeaux.jpeg') %>"
    alt="Bordeaux"
    class="hero__fallback"
    aria-hidden="true"
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:none;z-index:0;pointer-events:none;">

  <!-- Vidéo en arrière-plan du HERO -->
  <video
    class="hero__bg"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    poster="<%= image_path('bordeaux.jpeg') %>"
    aria-hidden="true"
    style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;pointer-events:none;">
    <source src="<%= asset_path('bordeaux.mp4') %>" type="video/mp4">
  </video>

  <!-- Voile pour la lisibilité du texte -->
  <div class="hero__overlay" aria-hidden="true"></div>

  <!-- CARD superposée -->
  <div class="hero__card">
    <h2 class="hero__title">Explore Bordeaux.<br>
    <strong>Trouver</strong>, choisir, <strong>sortir.</strong></h2>
    <p class="hero__text">
      L’outil qui trouve vos sorties en un clic.
    </p>
    <button class="hero__button">Je me lance.</button>

  </div>

  <!-- JS désactivé → force l'image -->
  <noscript>
    <style>
      .hero__bg{display:none!important}
      .hero__fallback{display:block!important}
    </style>
  </noscript>
</section>

<script>
  (function () {
    var v = document.querySelector('.hero .hero__bg');
    var img = document.querySelector('.hero .hero__fallback');
    if (!v || !img) return;

    function showFallback() {
      v.style.display = 'none';
      img.style.display = 'block';
    }

    // Fallback uniquement si vraie erreur de lecture
    v.addEventListener('error', showFallback, { once: true });

    // Booster autoplay post-login / Turbo / iOS
    function tryPlay() {
      // s'assurer des flags avant play()
      v.muted = true;
      v.autoplay = true;
      v.playsInline = true;

      var p = v.play && v.play();
      if (p && p.catch) {
        // si la policy bloque l'autoplay, bascule image
        p.catch(showFallback);
      }
    }

    // essais immédiats et quand la vidéo est prête
    tryPlay();
    v.addEventListener('canplay', tryPlay, { once: true });

    // si la page redevient visible
    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && v.paused) tryPlay();
    });

    // compat Turbo/Hotwire
    document.addEventListener('turbo:load', tryPlay);
    document.addEventListener('turbo:render', tryPlay);
    document.addEventListener('turbo:before-cache', function () {
      try { v.pause(); v.currentTime = 0; } catch(e){}
    });

    // quelques relances dans la première seconde (réseaux lents)
    var n = 0, id = setInterval(function () {
      if (!v.paused || n++ >= 3) return clearInterval(id);
      tryPlay();
    }, 300);

    // Assure la boucle si l'attribut loop est ignoré
    v.addEventListener('ended', function () {
      try { v.currentTime = 0; v.play(); } catch(e){}
    });
  })();
</script>



<% moods = {
  "Nature"   => "moods/nature.jpg",
  "Creatif"  => "moods/creatif.jpg",
  "Festif"   => "moods/festif.jpg",
  "Foodies"  => "moods/foodies.jpg",
  "Culturel" => "moods/culturel.jpg",
  "Chill"    => "moods/chill.jpg"
} %>

<% budgets = {
  "Gratuit"               => "budget/Gratuit.png",
  "Entre_0_et_40_euros"   => "budget/Entre_0_et_40_euros.png",
  "Plus_de_40_euros"      => "budget/Plus_de_40_euros.png"
} %>

<%= form_with url: events_path, method: :get, class: "filters-form" do %>

  <!-- MOODS -->
    <h2 class="filters-title-mood">Ton mood</h2>
    <p class="filters-subtitle">On adapte les suggestions à ton humeur.</p>
<section class="mood-section">
    <div class="mood-grid">
      <% moods.each do |tag, img| %>
        <% id = "tag_#{tag.parameterize}" %>
        <input type="checkbox"
               name="tags"
               value="<%= tag %>"
               id="<%= id %>"
               class="mood-check">

        <label for="<%= id %>" class="mood-card" style="--photo: url('<%= asset_path(img) %>')">
          <span class="mood-card__photo"></span>
          <span class="mood-card__title"><%= tag %></span>
        </label>
      <% end %>
    </div>
  </section>

  <!-- BUDGET -->
    <h2 class="filters-title-budget">Ton budget</h2>
    <p class="filters-subtitle">Ton portefeuille aussi a son mot à dire 😉</p>
  <section class="budget-section">
    <div class="budget-grid">
      <% budgets.each do |label, img| %>
        <% id = "budget_#{label.parameterize}" %>
        <input type="radio"
               name="budget"
               value="<%= label %>"
               id="<%= id %>"
               class="budget-input">

        <label for="<%= id %>" class="budget-card">
          <span class="budget-card__title">
            <%= label.gsub("_", " ").gsub("euros","€") %>
          </span>
        </label>
      <% end %>
    </div>
  </section>

    <h2 class="localisation__title">Ta localisation</h2>
    <p class="filters-subtitle">On te propose les spots près de toi.</p>
    <section class="localisation">
      <div class="container">
        <div style="text-align: center;">
          <input type="range" name="location" min="10" max="30" step="10" value="20" class="localisation__range">
          <div class="localisation__labels">
            <span>10 km</span>
            <span>20 km</span>
            <span>30 km</span>
          </div>

      </div>
    </div>
    </section>
    <section class="choose-date">
  <div class="container">
    <h2 class="choose-date__title">Ta date</h2>
    <p class="filters-subtitle">Sélectionne ton moment.</p>
    <div class="choose-date__form">
      <div class="choose-date__fields">
        <div class="choose-date__field">
          <label for="start_date">Date de début</label>
          <input type="date" data-controller="flatpickr" id="start_date" name="start_date" placeholder="Sélectionne une date">
        </div>

        <div class="choose-date__field">
          <label for="end_date">Date de fin</label>
          <input type="date" data-controller="flatpickr" id="end_date" name="end_date" placeholder="Sélectionne une date">
        </div>
      </div>
    </div>
  </div>
</section>
  <!-- SUBMIT -->
<div class="filters-actions d-flex justify-content-center">
  <%= submit_tag "RECHERCHER UN ÉVÈNEMENT", class: "btn-custom" %>
</div>
<% end %>





