<header class="header">
  <div class="header-container">
    <!-- Logo centré -->
    <div class="logo">
      <%= link_to root_path do %>
        <%= image_tag "logofinale.png", alt: "logo explore bdx", class: "logo-img" %>
      <% end %>
    </div>

    <!-- Icône utilisateur -->
    <div class="user-icon">
      <%= link_to root_path do %>
        <%= image_tag "user-icon.png", alt: "picto", class: "user-icon-img" %>
      <% end %>
    </div>

    <!-- Flash dans le header -->
    <% flash.each do |key, message| %>
      <div class="flash <%= key %>"><%= message %></div>
    <% end %>
  </div>
  </div>
</header>
