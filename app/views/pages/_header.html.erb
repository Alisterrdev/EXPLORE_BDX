<header class="header">
  <div class="header-container">
    <!-- Logo centré -->
    <div class="logo">
      <%= link_to root_path do %>
        <%= image_tag "logofinale.png", alt: "logo explore bdx", class: "logo-img" %>
      <% end %>
    </div>

<div class="user-actions">
    <!-- Icône utilisateur -->
    <div class="user-icon">
      <%= link_to root_path do %>
  <%= raw File.read(Rails.root.join("app/assets/images/user.svg")) %>
</div>
      <% end %>
    </div>

    <!-- Coeur  -->
    <div class="favorites-link">
      <%= link_to "/events/155/favorites" do %>
    <%= raw File.read(Rails.root.join("app/assets/images/heart.svg")) %>
    <% end %>
    </div>
</div>

    <!-- Flash dans le header -->
    <% flash.each do |key, message| %>
  <%# rien affiché volontairement %>
    <% end %>
  </div>
  </div>
