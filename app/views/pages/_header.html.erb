<header class="header">
  <div class="header-container">
    <!-- Logo centré -->
    <div class="logo">
      <%= link_to root_path do %>
        <%= image_tag "logofinale.png", alt: "logo explore bdx", class: "logo-img" %>
      <% end %>
    </div>

<div class="user-actions">
    <!-- Icône utilisateur -->
    <div class="user-icon">
      <%= link_to root_path do %>
        <%= image_tag "user-icon.png", alt: "picto", class: "user-icon-img" %>
      <% end %>
    </div>

    <!-- Coeur  -->
    <div class="favorites-link ">
      <%= link_to favorites_path do %>
        <%= image_tag "suit-heart.svg", alt: "Mes Favoris", class: "favorites-link-img" %>
      <% end %>
    </div>
</div>

    <!-- Flash dans le header -->
    <% flash.each do |key, message| %>
  <%# rien affiché volontairement %>
    <% end %>
  </div>
  </div>
</header>
