<section class="event-suggestions">

  <h2 class="title-map">Les événements près de chez toi en un click</h2>
  <div class="map-container">
    <div data-controller="map"
        data-map-markers-value="<%= @markers.to_json %>"
        data-map-user-marker-value="<%= @user_marker.to_json %>"
        data-map-api-key-value="<%= ENV['MAPBOX_API_KEY'] %>"
        class="map-wrapper">
      <div class="event-sidebar" data-map-target="sidebar">
        <div class="sidebar-content" data-map-target="sidebarContent">
        </div>
        <button class="close-sidebar" data-map-target="closeButton">×</button>
      </div>
      <div class="map-display" data-map-target="mapElement">
        <%# C'est ici, grâce à la target (mapElement) qu'on va insérer la map %>
      </div>
    </div>
  </div>
</section>

 </div>
   <section class="event-suggestions">
    <h2>Les événements dans le même genre</h2>
    <div class="event-cards">
      <% if @events.any? %>
        <% @events.each do |event| %>
          <%= render "events/show-card", event: event %>
        <% end %>
      <% else %>
        <em>Désolé, aucun événement n'a été trouvé.</em>
      <% end %>
    </div>
  </section>
