<section class="event-show">
  <!-- HERO -->
  <div class="event-hero">
    <div class="event-hero__image">
      <%= image_tag @event.image || "placeholder.jpeg", alt: @event.name %>
    </div>

    <div class="event-hero__content">
      <h1 class="event-title"><%= @event.name %></h1>
      <p class="event-subtitle"><%= @event.tags %></p>

      <div class="event-card">
        <p><strong>📍Lieu:</strong> <%= @event.address %></p>
        <p><strong>📅 Date:</strong> <%= I18n.l(@event.date) %></p>
        <p><strong>⏰ Heure:</strong> 18h30</p>
      </div>

      <div id="favorite-btn">
        <% if current_user.favorites.exists?(event: @event) %>
          <% favorite = current_user.favorites.find_by(event: @event) %>
          <%= link_to event_favorite_path(@event, favorite),
                      method: :delete,
                      data: { turbo_method: :delete },
                      class: "favorite-link active" do %>
            Retirer de mes favoris
            <i class="heart-icon fa-solid fa-heart"></i>
          <% end %>
        <% else %>
          <%= link_to event_favorites_path(@event),
                      method: :post,
                      data: { turbo_method: :post },
                      class: "favorite-link" do %>
            Ajouter à mes favoris
            <i class="heart-icon fa-regular fa-heart"></i>
          <% end %>
        <% end %>
      </div>
    </div> <!-- /.event-hero__content -->
  </div>   <!-- /.event-hero -->
</section>


  <!-- DESCRIPTION / GALERY -->
<section class="event-description">
  <div class="gallery-block">

    <!-- Colonne gauche (texte) -->
    <div class="gallery-text">
      <h2>À propos de l’événement</h2>

      <h3><%= @event.description_title %></h3>
      <p><%= @event.description %></p>

      <h3><%= @event.details_title %></h3>
      <p><%= @event.details %></p>
    </div>

    <!-- Colonne droite (mosaïque 2×2) -->
    <div class="gallery-images">
      <% if @event.files.attached? %>
        <% @event.files.limit(4).each_with_index do |file, index| %>
          <div class="image-container image-<%= index + 1 %>">
            <%= image_tag file, alt: "Image #{index + 1}" %>
          </div>
        <% end %>
      <% else %>
        <% 4.times do |i| %>
          <div class="image-container image-<%= i + 1 %>"></div>
        <% end %>
      <% end %>
    </div>

  </div>
</section>




  <!-- AUTRES EVENTS -->
  <section class="event-suggestions">
    <h2>D'autres événements qui pourraient vous intéresser</h2>
    <div class="event-cards">
      <% if @events.any? %>
        <% @events.each do |event| %>
          <div class="event-card">
            <%= image_tag event.image || "placeholder.jpg", alt: event.name, class: "event-card-image" %>
            <h4><%= event.name %></h4>
            <p><%= I18n.l(event.date) %></p>
            <p><%= truncate(event.description, length: 50) %></p>
            <a href="<%= event_path(event) %>" class="btn-secondary">En savoir plus</a>
          </div>
        <% end %>
      <% else %>
        <em>Désolé, aucun événement n'a été trouvé.</em>
      <% end %>
    </div>
  </section>
</section>
